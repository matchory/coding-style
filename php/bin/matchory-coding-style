#!/usr/bin/env php
<?php

/**
 * This file is part of matchory/coding-style, a Matchory project.
 *
 * Unauthorized copying of this file, via any medium, is strictly prohibited.
 * Its contents are strictly confidential and proprietary.
 *
 * @copyright © 2026 Matchory GmbH · All rights reserved
 */

declare(strict_types=1);

/**
 * Copies the configuration files that cannot be extended from a package into the current project.
 *
 * Pint (`--config`), PHPStan (`includes:`) and Rector (a PHP call) all read configuration straight
 * out of `vendor/`, so they need nothing from this command. `.editorconfig` is the exception:
 * EditorConfig resolves `root = false` by walking up the directory tree and has no way to reference
 * a file inside a package, so the canonical copy has to be written into the repository.
 *
 * Usage:
 *
 *     vendor/bin/matchory-coding-style sync
 *     vendor/bin/matchory-coding-style sync --check
 */

$packageRoot = dirname(__DIR__, 2);
$projectRoot = getcwd();

if ($projectRoot === false) {
    fwrite(STDERR, "Cannot determine the current working directory\n");

    exit(1);
}

$arguments = array_slice($argv, 1);
$command = $arguments[0] ?? 'sync';
$check = in_array('--check', $arguments, true);

if ( ! in_array($command, ['sync', 'help', '--help', '-h'], true)) {
    fwrite(STDERR, sprintf("Unknown command '%s'\n", $command));

    exit(1);
}

if ($command !== 'sync') {
    echo <<<'USAGE'
        matchory-coding-style sync [--check]

          Writes the configuration files that cannot be extended from a package into the current
          project. Currently: .editorconfig

          --check  Exit non-zero if a file is missing or out of date, without writing. Use in CI.

        USAGE;

    exit(0);
}

/**
 * Files copied verbatim from the package into the project root.
 *
 * @var array<string, string>
 */
$managed = [
    '.editorconfig' => $packageRoot . '/.editorconfig',
];

$stale = [];

foreach ($managed as $target => $source) {
    $expected = file_get_contents($source);

    if ($expected === false) {
        fwrite(STDERR, sprintf("Cannot read '%s' from the package\n", $target));

        exit(1);
    }

    $targetPath = $projectRoot . '/' . $target;
    $current = is_file($targetPath) ? file_get_contents($targetPath) : null;

    if ($current === $expected) {
        echo sprintf("unchanged  %s\n", $target);

        continue;
    }

    if ($check) {
        $stale[] = $target;

        continue;
    }

    if (file_put_contents($targetPath, $expected) === false) {
        fwrite(STDERR, sprintf("Cannot write '%s'\n", $target));

        exit(1);
    }

    echo sprintf("%s  %s\n", $current === null ? 'created   ' : 'updated   ', $target);
}

if ($stale !== []) {
    fwrite(STDERR, sprintf(
        "Out of date: %s\nRun `vendor/bin/matchory-coding-style sync`\n",
        implode(', ', $stale),
    ));

    exit(1);
}
