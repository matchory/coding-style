{
  "name": "@matchory/coding-style",
  "version": "0.1.0",
  "description": "Shared code style configuration for Matchory projects: oxlint, oxfmt, ESLint and TypeScript presets.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matchory/coding-style.git",
    "directory": "js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./eslint": {
      "types": "./src/eslint/base.d.ts",
      "default": "./src/eslint/base.js"
    },
    "./eslint/vue": {
      "types": "./src/eslint/vue.d.ts",
      "default": "./src/eslint/vue.js"
    },
    "./oxlint": {
      "types": "./src/oxlint/base.d.ts",
      "default": "./src/oxlint/base.js"
    },
    "./oxlint/vue": {
      "types": "./src/oxlint/vue.d.ts",
      "default": "./src/oxlint/vue.js"
    },
    "./oxfmt": {
      "types": "./src/oxfmt/base.d.ts",
      "default": "./src/oxfmt/base.js"
    },
    "./tsconfig/base.json": "./src/tsconfig/base.json",
    "./tsconfig/vue.json": "./src/tsconfig/vue.json",
    "./tsconfig/node.json": "./src/tsconfig/node.json",
    "./tsconfig/strict.json": "./src/tsconfig/strict.json",
    "./generated/oxlintrc.json": "./generated/oxlintrc.json",
    "./generated/oxfmtrc.json": "./generated/oxfmtrc.json",
    "./editorconfig": "./generated/.editorconfig"
  },
  "bin": {
    "matchory-coding-style": "./bin/cli.mjs"
  },
  "files": [
    "src",
    "generated",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-oxlint": "^1.40.0",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-vue": "^10.6.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.47.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "oxfmt": ">=0.1.0",
    "oxlint": ">=1.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
